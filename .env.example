# Database
DATABASE_URL=mysql://mindelta:mindelta_dev_password@localhost:3306/mindelta
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=mindelta
DATABASE_PASSWORD=mindelta_dev_password
DATABASE_NAME=mindelta

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS Services
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mindelta-uploads
AWS_CLOUDFRONT_DOMAIN=cdn.mindelta.com
AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/MediaConvert_Default_Role
AWS_MEDIACONVERT_ENDPOINT=https://abcd1234.mediaconvert.us-east-1.amazonaws.com
VIDEO_OUTPUT_PREFIX=videos

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=mindelta-embeddings

# Blockchain
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=your-polygon-private-key
CONTRACT_ADDRESS=your-deployed-contract-address

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mindelta.com

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# Carbon Footprint API
CARBON_INTENSITY_API_URL=https://api.carbonintensity.org.uk
CARBON_THRESHOLD_GCO2_KWH=500
NEXT_PUBLIC_CARBON_INTENSITY_API_URL=https://api.carbonintensity.org.uk
NEXT_PUBLIC_CARBON_THRESHOLD_GCO2_KWH=500

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# File Upload
MAX_FILE_SIZE=2147483648
ALLOWED_FILE_TYPES=video/mp4,video/webm,application/pdf,image/jpeg,image/png
