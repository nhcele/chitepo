# Environment Configuration
NODE_ENV=development

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=mindelta_user
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=mindelta_dev

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_PORT=3000
API_HOST=localhost

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# External Services
OPENAI_API_KEY=your_openai_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=mindelta-files

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Blockchain Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
PRIVATE_KEY=your_private_key_here
CONTRACT_ADDRESS=your_contract_address_here


# --- Added: required/recommended for auth, email & fail-fast validation ---
# JWT_SECRET is validated at boot (>=16 chars, not a default) — REQUIRED in all envs.
# Frontend base URL used in verification / password-reset email links and CORS.
FRONTEND_URL=http://localhost:3000
# Sender address for outbound emails (verification, password reset, etc.)
FROM_EMAIL=noreply@example.com
# Recommended strong secrets in production (warned about at boot if weak/unset).
SESSION_SECRET=change_me_to_a_long_random_string
ENCRYPTION_KEY=change_me_to_a_32_byte_random_key
# Google OAuth (leave unset to disable Google sign-in in development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
