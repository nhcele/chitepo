{
  "name": "@mindelta/backend",
  "version": "1.0.0",
  "description": "Mindelta backend API services",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test,e2e}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:install": "playwright install",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:utils": "ts-node src/database/migration-utils.ts",
    "migration:reset": "npm run migration:utils reset",
    "migrate": "ts-node src/database/run-migrations.ts",
    "db:setup": "ts-node src/database/setup-database.ts",
    "db:reset": "npm run migration:reset && npm run seed:run",
    "seed": "ts-node src/database/seeds/run-seeds.ts",
    "seed:run": "ts-node src/database/seeds/run-seeds.ts",
    "seed:dev": "ts-node src/database/seeds/seed-development.ts",
    "seed:courses": "ts-node src/database/seeds/run-seeds.ts",
    "seed:quizzes:content": "ts-node src/database/seeds/run-lesson-content-quizzes.ts",
    "seed:quizzes:dcc": "ts-node src/database/seeds/run-lesson-content-quizzes-dcc.ts",
    "seed:quizzes:dcc:markdown": "ts-node src/database/seeds/run-dcc-markdown-quizzes.ts",
    "seed:quizzes:dcc:markdown:replace": "ts-node src/database/seeds/run-dcc-markdown-quizzes.ts --replace",
    "report:dcc:quizzes": "ts-node src/database/seeds/report-dcc-quiz-status.ts",
    "update:categories": "ts-node src/database/update-course-categories.ts",
    "migrate:user-groups": "ts-node src/database/run-user-groups-migration.ts",
    "create:messages-table": "ts-node src/database/create-messages-table.ts"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.919.0",
    "@aws-sdk/client-s3": "^3.919.0",
    "@aws-sdk/s3-request-presigner": "^3.919.0",
    "@mindelta/shared": "file:../shared",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^5.0.1",
    "@nestjs/typeorm": "^10.0.1",
    "@pinecone-database/pinecone": "^6.1.2",
    "aws-sdk": "^2.1509.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cache-manager": "^5.3.2",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "ethers": "^6.15.0",
    "fast-xml-parser": "^4.3.6",
    "helmet": "^7.1.0",
    "ipfs-http-client": "^60.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.7",
    "openai": "^4.20.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pinecone-client": "^1.1.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.11",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.11.0",
    "typeorm": "^0.3.17",
    "unzipper": "^0.10.14",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.9.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/unzipper": "^0.10.10",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.3.2"
  }
}


