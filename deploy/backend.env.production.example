# ── Chitepo backend — production environment ──
# Copy to  backend/.env  and fill in every CHANGE_ME value.
#   cp deploy/backend.env.production.example backend/.env

NODE_ENV=production
PORT=4001

# Public site URL (used for CORS + generated links). MUST match your subdomain.
# CORS: comma-separated ORIGINS (scheme+host, NO path)
FRONTEND_URL=https://huku.tech
# Base for upload URLs; keep relative so files resolve on any host
API_URL=/chitepo

# ── Database: your existing MySQL on the VPS (see deploy/setup-database.sql) ──
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=chitepo
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_NAME=chitepo

# ── Redis: sudo apt install redis-server ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Secrets — generate EACH separately with:  openssl rand -hex 32 ──
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── Rate limiting (optional) ──
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# ── AI features: disabled for now. Add keys later + `pm2 restart chitepo-backend`. ──
OPENAI_API_KEY=
PINECONE_API_KEY=
