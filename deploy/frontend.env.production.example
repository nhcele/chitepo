# ── Chitepo frontend — production BUILD environment ──
# Copy to  frontend/.env.production  BEFORE running the build.
#   cp deploy/frontend.env.production.example frontend/.env.production
#
# NEXT_PUBLIC_* values are baked into the compiled JS at build time. If you change
# either of these you MUST rebuild the frontend (npm run build:frontend).

# Public base URL of the app, INCLUDING the sub-path. The API client appends /api.
NEXT_PUBLIC_API_URL=/chitepo

# Sub-path the app is served under. Drives Next.js basePath + the fetch/link
# helpers. Leave EMPTY (or unset) to serve at a domain root instead.
NEXT_PUBLIC_BASE_PATH=/chitepo

NODE_ENV=production
