# ── Chitepo frontend — production BUILD environment ──
# Copy to  frontend/.env.production  BEFORE running the build.
#   cp deploy/frontend.env.production.example frontend/.env.production
#
# NEXT_PUBLIC_* values are baked into the compiled JS at build time, so if you
# change the subdomain you must rebuild the frontend (npm run build:frontend).
# The API client appends /api automatically — do NOT put /api here.

NEXT_PUBLIC_API_URL=https://chitepo.example.com
NODE_ENV=production
